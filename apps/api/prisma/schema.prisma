generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  SUPPORT
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SUBMITTING
  RETRY_SUBMIT
  SUBMIT_FAILED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  CANCEL_REQUESTED
  CANCELLED
  CANCEL_REJECTED
  REFILL_REQUESTED
  REFILL_DONE
  REFILL_FAILED
  EXPIRED
}

enum PricingRuleType {
  FIXED_PRICE
  PERCENT_MARGIN
  FIXED_MARGIN
}

enum WebhookSource {
  PANELFOLLOWS
  YENGAPAY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("users")
}

model Category {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  displayOrder Int             @default(0)
  isVisible    Boolean         @default(true)
  services     CatalogService[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("categories")
}

/// Mirror of the PanelFollows /services catalog. Never exposed directly to clients.
model ProviderService {
  id                 String   @id @default(cuid())
  providerServiceId  Int      @unique
  name               String
  description        String?
  type               String
  platform           String
  categorySlug       String
  categoryName       String
  rateUsd            Decimal  @db.Decimal(12, 4)
  unit               String
  minQuantity        Int
  maxQuantity        Int
  refillSupported    Boolean  @default(false)
  cancelSupported    Boolean  @default(false)
  dripfeedSupported  Boolean  @default(false)
  averageTimeSeconds Int?
  fieldsSchema       Json
  isActiveUpstream   Boolean  @default(true)
  lastSyncedAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  catalogServices CatalogService[]

  @@map("provider_services")
}

/// The reseller's own catalog entry, shown to clients under our brand.
model CatalogService {
  id                String          @id @default(cuid())
  providerServiceId String
  providerService   ProviderService @relation(fields: [providerServiceId], references: [id])
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])

  name         String
  description  String?
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  pricingRuleType PricingRuleType
  pricingValue    Decimal @db.Decimal(12, 4)
  roundingStep    Decimal? @db.Decimal(12, 4)
  minPriceXof     Decimal? @db.Decimal(12, 2)
  maxPriceXof     Decimal? @db.Decimal(12, 2)

  /// Optional override, must stay within provider's own min/max, never wider.
  minQuantityOverride Int?
  maxQuantityOverride Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("catalog_services")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  /// XOF per 1 USD, set manually by an admin.
  rateXofPerUsd Decimal @db.Decimal(12, 4)
  setByUserId   String
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("exchange_rates")
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  catalogServiceId String
  catalogService   CatalogService @relation(fields: [catalogServiceId], references: [id])

  targetLink String
  quantity   Int

  priceClientXof Decimal @db.Decimal(12, 2)
  costProviderUsd Decimal @db.Decimal(12, 4)
  fxRateUsed     Decimal @db.Decimal(12, 4)
  marginXof      Decimal @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING_PAYMENT)

  providerOrderId  Int?
  providerStatusRaw String?
  startCount       Int?
  remains          Int?

  errorLog Json?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  payment         Payment?
  refillRequests  RefillRequest[]
  cancelRequests  CancelRequest[]

  @@index([userId])
  @@index([orderStatus])
  @@map("orders")
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  /// Our own idempotency key, sent to Yengapay as `reference`.
  reference String @unique

  yengapayPaymentIntentId String?
  amountXof               Decimal @db.Decimal(12, 2)
  feesXof                 Decimal? @db.Decimal(12, 2)
  operatorCode            String?
  status                  PaymentStatus @default(PENDING)
  expiresAt               DateTime?

  rawInitResponse    Json?
  rawConfirmResponse Json?
  rawWebhookPayload  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model RefillRequest {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  providerRefillId  Int?
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("refill_requests")
}

model CancelRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cancel_requests")
}

/// Dedup table for both PanelFollows and Yengapay webhook deliveries.
model WebhookEvent {
  id              String        @id @default(cuid())
  source          WebhookSource
  externalEventId String
  signatureValid  Boolean
  processedAt     DateTime?
  rawPayload      Json
  createdAt       DateTime      @default(now())

  @@unique([source, externalEventId])
  @@map("webhook_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
