# --- Server ---
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000
# Shared secret Vercel Cron sends as `Authorization: Bearer <this>` — see vercel.json
CRON_SECRET=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql://boostora:boostora@localhost:5432/boostora

# --- PanelFollows (v3 REST API) ---
# https://panelfollows.com/en/api-docs — Authorization: Bearer <key>
PANELFOLLOWS_API_KEY=pf_live_xxx
PANELFOLLOWS_BASE_URL=https://panelfollows.com/api/v3
# Signing secret returned once when registering a webhook endpoint (POST /webhooks)
PANELFOLLOWS_WEBHOOK_SECRET=whsec_xxx

# --- Yengapay ---
# Organisation and Project id come from the Yengapay dashboard (Paramètres > Organisation / Configuration)
YENGAPAY_BASE_URL=https://api.yengapay.com/api/v1
YENGAPAY_ORGANIZATION_ID=xxx
YENGAPAY_PROJECT_ID=xxx
# API key scoped to "Créer un paiement entrant" (Paramètres > Clés API)
YENGAPAY_API_KEY=xxx
# Project-level webhook secret (Configuration > Secret du webhook), used to verify x-webhook-hash
YENGAPAY_WEBHOOK_SECRET=xxx

# --- Business config ---
# Manual fallback if no ExchangeRate row exists yet in DB
DEFAULT_XOF_PER_USD=615
